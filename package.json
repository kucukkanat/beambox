{
  "name": "monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && turbo run typecheck test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "stats": "node scripts/spec-stats.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
