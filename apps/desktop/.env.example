# Only for `npm run release:macos` (signed, notarized macOS build). Copy to .env; never commit .env.
# The Developer ID Application certificate must be in your login keychain. See README.md#releasing-for-macos.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
APPLE_ID=you@example.com
APPLE_PASSWORD=app-specific-password
APPLE_TEAM_ID=TEAMID1234
