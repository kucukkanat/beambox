{
  "name": "@repo/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Beambox desktop: GUI workspaces for AI agents on microsandbox (Tauri 2)",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/fetch-runtime.mjs && tauri dev --config src-tauri/tauri.runtime.conf.json",
    "dev:web": "vite",
    "build": "node scripts/fetch-runtime.mjs && tauri build --config src-tauri/tauri.runtime.conf.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json && node scripts/cargo.mjs check --all-targets",
    "test": "vitest run && node scripts/cargo.mjs test",
    "check:images": "node scripts/check-image-size.mjs",
    "clean": "rm -rf dist .turbo src-tauri/target"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@tauri-apps/api": "^2.12.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
