{
  "name": "@repo/sandbox-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Beambox's MCP server that runs inside each agent sandbox, bundled into one file (mcp.js)",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --minify --outfile=dist/mcp.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@repo/source --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "esbuild": "^0.28.2"
  }
}
