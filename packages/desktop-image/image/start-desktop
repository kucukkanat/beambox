#!/bin/sh
# Beambox runs this after every boot. Starts the desktop in the background and returns once VNC is listening.
# A UTF-8 locale (built into glibc), so xterm and tmux draw the bullets, arrows and box lines agents print.
export DISPLAY=:0 XENVIRONMENT=/etc/beambox/Xresources LANG=C.UTF-8
# The desktop in a browser, opt-in: noVNC on WEB_PORT (or the port in /etc/beambox/web-port, which Beambox writes so
# it lasts across restarts), through websockify to VNC. websockify doesn't check which site a connection comes
# from, so any open web page could reach a passwordless desktop on localhost. It only connects requests that carry
# the random token in /etc/beambox/web-token instead, which is in the printed link.
web_port=${WEB_PORT:-$(cat /etc/beambox/web-port 2>/dev/null)}
if [ -n "$web_port" ] && ! pgrep -f websockify >/dev/null; then
  mkdir -p /etc/beambox
  [ -s /etc/beambox/web-token ] || od -An -tx1 -N16 /dev/urandom | tr -d ' \n' >/etc/beambox/web-token
  token=$(cat /etc/beambox/web-token)
  (umask 077 && echo "$token: localhost:5900" >/etc/beambox/web-targets)
  setsid python3 -m websockify --web /usr/share/novnc --token-plugin ReadOnlyTokenFile \
    --token-source /etc/beambox/web-targets "$web_port" >/tmp/websockify.log 2>&1 &
  echo "The desktop in a browser (use the host port you published $web_port on):"
  echo "http://127.0.0.1:$web_port/vnc.html?autoconnect=1&resize=remote&path=websockify%3Ftoken%3D$token"
fi
pgrep Xvnc >/dev/null && exit 0
# /tmp is on the sandbox's disk, so a stopped or forked sandbox keeps the old server's lock and socket, and X
# would refuse to start ("Server is already active for display 0").
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
# Xvnc is the X server and the VNC server in one: it resizes to the viewer's window (no blurry scaling) and
# sends changes as they're drawn. No VNC password: the port is only published on the host's 127.0.0.1.
# -noreset: by default X resets, wiping the background, whenever its last client disconnects.
setsid Xvnc :0 -geometry 1280x800 -depth 24 -dpi 96 -rfbport 5900 -SecurityTypes None -AlwaysShared \
  -noreset >/tmp/xvnc.log 2>&1 &
# An arrow cursor (X's default is a cross); also waits (up to 5 s) until X accepts clients.
i=0
until xsetroot -solid '#1a2238' -cursor_name left_ptr 2>/dev/null || [ "$i" -ge 50 ]; do
  i=$((i + 1))
  sleep 0.1
done
setsid openbox >/tmp/openbox.log 2>&1 &
# Window shadows, and see-through dock and top bar. (picom loses track of windows under Xvnc.)
setsid xcompmgr -c -C -r 12 -o 0.45 -l -14 -t -12 >/dev/null 2>&1 &
setsid tint2 -c /etc/xdg/tint2/tint2rc >/tmp/tint2.log 2>&1 &
# One session bus for the desktop: Plank keeps its settings in dconf, which needs one.
eval "$(dbus-launch --sh-syntax)"
# The background and the Plank dock, refitted whenever the screen changes size (desktop-watch).
setsid desktop-watch >/tmp/desktop-watch.log 2>&1 &
# Copy and paste between the desktop and the app.
setsid vncconfig -nowin >/dev/null 2>&1 &
# Short enough to clear the dock on a small viewer window.
setsid xterm -geometry 96x20+40+60 >/dev/null 2>&1 &
# Return once VNC is listening (up to 5 s), so the Desktop tab can connect as soon as the sandbox is ready.
i=0
until netstat -ltn | grep -q ':5900 ' || [ "$i" -ge 50 ]; do
  i=$((i + 1))
  sleep 0.1
done
